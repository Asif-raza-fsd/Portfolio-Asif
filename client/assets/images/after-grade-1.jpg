<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="cinemaNight" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#08141F"/>
      <stop offset="60%" stop-color="#0B1C28"/>
      <stop offset="100%" stop-color="#120A05"/>
    </linearGradient>
    <radialGradient id="neonOrange" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FF7700" stop-opacity="0.9"/>
      <stop offset="60%" stop-color="#E46400" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#E46400" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="neonTeal" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#00E5FF" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#003344" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="800" height="500" fill="url(#cinemaNight)"/>
  <!-- Street & City Silhouettes (Deep Inky Blacks & High Contrast) -->
  <rect x="0" y="320" width="800" height="180" fill="#05090D"/>
  <!-- Wet asphalt reflections -->
  <ellipse cx="380" cy="400" rx="140" ry="25" fill="#FF6B00" opacity="0.35"/>
  <ellipse cx="580" cy="380" rx="90" ry="15" fill="#00E5FF" opacity="0.25"/>
  
  <polygon points="120,320 180,180 240,320" fill="#0B1924"/>
  <rect x="300" y="160" width="160" height="160" fill="#0E2230" stroke="#00E5FF" stroke-width="1.5" stroke-opacity="0.4"/>
  <rect x="520" y="120" width="140" height="200" fill="#0A1822"/>
  
  <!-- Glowing Vibrant Signage & Halation -->
  <circle cx="380" cy="220" r="60" fill="url(#neonOrange)"/>
  <circle cx="380" cy="220" r="22" fill="#FFA500"/>
  <circle cx="580" cy="180" r="50" fill="url(#neonTeal)"/>
  <rect x="330" y="260" width="100" height="12" rx="3" fill="#00E5FF"/>
  
  <text x="40" y="60" fill="#FF8800" font-family="sans-serif" font-size="22" font-weight="700" letter-spacing="1">CINEMATIC GRADE (Rec.709)</text>
  <text x="40" y="90" fill="#00E5FF" font-family="sans-serif" font-size="14">DaVinci Resolve Studio • Deep Teal &amp; Orange Split • Film Contrast</text>
</svg>