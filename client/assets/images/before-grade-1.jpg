<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <linearGradient id="logGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#55585C"/>
      <stop offset="50%" stop-color="#676B70"/>
      <stop offset="100%" stop-color="#4E5155"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#logGrad1)"/>
  <!-- Street & City Silhouettes (Low contrast flat LOG) -->
  <rect x="0" y="320" width="800" height="180" fill="#4B4E52"/>
  <polygon points="120,320 180,180 240,320" fill="#5F6368" opacity="0.6"/>
  <rect x="300" y="160" width="160" height="160" fill="#5A5E63" opacity="0.7"/>
  <rect x="520" y="120" width="140" height="200" fill="#53575B" opacity="0.6"/>
  <!-- Flat low-saturation neon signs -->
  <circle cx="380" cy="220" r="18" fill="#888F96" opacity="0.8"/>
  <rect x="330" y="260" width="100" height="10" rx="3" fill="#8D949C"/>
  <text x="40" y="60" fill="#8E9296" font-family="sans-serif" font-size="22" font-weight="700" letter-spacing="1">RAW LOG (Sony S-Log3)</text>
  <text x="40" y="90" fill="#75797E" font-family="sans-serif" font-size="14">Uncorrected Flat Sensor Data • Low Contrast • Wide Gamut</text>
</svg>